# Copy to .env and `export $(cat .env | xargs)` (or use your shell's way). NEVER commit .env.
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
RPC_URL=             # Robinhood Chain RPC (from official docs)
CHAIN_ID=            # Robinhood Chain chain id (from official docs)
CHAIN_NAME=Robinhood Chain
EXPLORER_URL=
NATIVE_SYMBOL=ETH
CLAIM_FEE_ETH=0.00004   # set so it equals ~$0.10 at current ETH price
TOKEN_NAME=Chomp
TOKEN_SYMBOL=CHOMP
WALLETCONNECT_PROJECT_ID=   # free from cloud.reown.com, enables mobile wallets via WalletConnect
