# "testnet" ya "mainnet"
NETWORK=testnet

# Mainnet ke liye ye EXACT "yes" hona chahiye, warna app start hi nahi hoga
CONFIRM_MAINNET=no

# Sirf PUBLIC key (xpub). Seed/mnemonic yahan KABHI mat daalna.
# `npm run wallet:new` se milega.
WALLET_XPUB=

# Database folder (embedded Postgres, alag install ki zaroorat nahi)
DB_DIR=./data/db

# Order ka payment window (minutes). Iske baad order expire ho jaata hai.
ORDER_TTL_MINUTES=30

# Kitne confirmations ke baad payment "paid" maani jaaye (reorg se bachne ke liye)
MIN_CONFIRMATIONS=10

# Expire hone ke baad kitne ghante tak late payments pakadne ke liye address dekhte rahein
LATE_GRACE_HOURS=168

# Abhi sirf "file" (local demo, nakli blockchain). Asli backend Step 3b mein.
CHAIN_BACKEND=file
FAKE_CHAIN_FILE=./data/fake-chain.json

# Apna paisa (revenue) nikalne ka address. Refund ka "change" bhi yahin jaata hai.
# Ye tumhara APNA wallet address hona chahiye (alag wallet, is xpub wala nahi).
TREASURY_ADDRESS=

# Refund ke baad buyer ko kam se kam itna (zats) milna chahiye, warna refund skip (dust/fee se chhota)
MIN_REFUND_NET_ZATS=10000

# Fee = FEE_MARGINAL_ZATS x max(FEE_GRACE_ACTIONS, inputs/outputs). ZIP 317 ke default. Mainnet se pehle latest rule check karna.
FEE_MARGINAL_ZATS=5000
FEE_GRACE_ACTIONS=2

# Signer safety: is se zyada fee wali transaction sign nahi hogi (zats)
MAX_FEE_ZATS=100000

# Creator payout: advance (trusted creators ke liye) is se chhota ho to nahi banta (zats). 1000000 = 0.01 ZEC
MIN_PAYOUT_ZATS=1000000

# Buyers ki report se auto-freeze: kam se kam itne alag buyers, ya total buyers ka itna % (jo bada ho)
REPORT_FREEZE_MIN=3
REPORT_FREEZE_PCT=10

# ---- Asli chain (lightwalletd protocol) ----
# CHAIN_BACKEND=lightwalletd  => asli blockchain (testnet ya mainnet). "file" = sirf nakli demo chain.
# LWD_URL: testnet mein khaali chhodo to public https://testnet.zec.rocks:443 use hota hai (sirf TESTING).
#          mainnet mein APNA server dena zaroori hai (Zebra + Zaino/lightwalletd).
# LWD_LOOKBACK_BLOCKS: address ke kitne pichhle blocks dekhne hain (late payment ki grace ke hisaab se)
CHAIN_BACKEND=file
LWD_URL=
LWD_LOOKBACK_BLOCKS=30000
LWD_TIMEOUT_MS=15000

# Txid server se cross-verify: unverified (default: v4/v6 jinke official vectors nahi) | all | off
LWD_VERIFY_TXIDS=unverified

# Refund tracker: tx expire hone ke baad itne blocks aur ruko (reorg safety), phir hi "failed" maano
REFUND_EXPIRY_MARGIN=100
# Broadcast ke itne minute baad bhi chain pe na dikhe to ALERT
REFUND_STUCK_MINUTES=15

# ---- Website (npm run app) ----
# HOST=127.0.0.1 => sirf tumhare computer se khulega (safe). Production mein reverse proxy ke peeche.
PORT=3000
HOST=127.0.0.1
# Har IP: kul requests / minute, aur naye orders / minute aur / ghanta (bots se bachav)
RATE_LIMIT_PER_MIN=120
ORDER_RATE_PER_MIN=5
ORDER_RATE_PER_HOUR=40
# Watcher (payment dekhna, mint, tracker) kitne ms mein ek baar
WORKER_INTERVAL_MS=10000

# Images ka folder (web/ ke bahar, seedha URL se nahi khulta; sirf mint hue token ki image API se milti hai)
ASSETS_DIR=./data/assets
# Images ke liye alag rate limit (har IP, per minute). Gallery mein kai images ek saath aati hain.
IMAGE_RATE_PER_MIN=600

# ---- Marketplace (resale) ----
# Har resale pe platform fee (basis points). 250 = 2.5%
MARKETPLACE_FEE_BPS=250

# ---- Verified badge ----
# Collection ka total volume (zats) isse zyada ho to automatic blue tick. 2000000000 = 20 ZEC
VERIFIED_VOLUME_ZATS=2000000000

# ---- Multi-currency display (optional) ----
# Manually set karo (admin -- set-rate se bhi badal sakte ho). Khaali chhodo to USD/INR price nahi dikhega.
ZEC_USD_RATE=
ZEC_INR_RATE=

# Creator self-upload: har file ek-ek karke seedhe DISK pe stream hoti hai (RAM me poora collection
# kabhi nahi aata), isliye ye do limits alag hain:
# UPLOAD_RATE_PER_MIN: bade collection (jaise 1000 images) upload karte waqt har image apni ALAG
# request me jaati hai -- isliye ye limit normal API se kahin zyada honi chahiye.
UPLOAD_RATE_PER_MIN=6000
# MAX_FILE_BYTES: ek image/json/csv file kitni badi ho sakti hai. 10485760 = 10 MB
MAX_FILE_BYTES=10485760
# MAX_SESSION_BYTES: poora collection (saari files mila ke) kitna bada ho sakta hai. 21474836400 = ~20 GB
# Isse zyada rakhna ho to bhi koi memory-risk nahi hai, sirf server ke disk space pe depend karta hai.
MAX_SESSION_BYTES=21474836480

# ---- Admin dashboard (/admin.html) ----
# Password DIRECT yahan mat likhna. `npm run admin:password` chalao, jo hash yahan daalna hai wo dega.
ADMIN_PASSWORD_HASH=
# Login ke baad session kitne ghante valid rahe
ADMIN_SESSION_HOURS=24
