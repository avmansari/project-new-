{
  "name": "project-new-",
  "version": "1.0.0",
  "description": "https://drive.google.com/drive/folders/1OLUHKGNSBcwCrs_PhZlf9YrtMuk2QPSU?usp=sharing",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "compile": "hardhat compile",
    "merkle": "node scripts/build-merkle.mjs",
    "node": "hardhat node",
    "deploy:local": "node scripts/build-merkle.mjs && hardhat run scripts/deploy.cjs --network localhost",
    "deploy:robinhood": "node scripts/build-merkle.mjs && hardhat run scripts/deploy.cjs --network robinhood",
    "serve": "npx http-server web -p 8080 -c-1",
    "build:wc": "esbuild tools/wc-entry.js --bundle --minify --format=iife --platform=browser --target=es2020 --define:process.env.NODE_ENV='\"production\"' --define:global=globalThis --outfile=web/vendor/walletconnect.bundle.js",
    "fund:local": "hardhat run scripts/fund-local.cjs --network localhost"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avmansari/project-new-.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/avmansari/project-new-/issues"
  },
  "homepage": "https://github.com/avmansari/project-new-#readme",
  "type": "module",
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "esbuild": "^0.28.2",
    "hardhat": "^2.29.1",
    "solc": "^0.8.28"
  }
}
