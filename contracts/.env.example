# ---- Robinhood Chain TESTNET deploy config ----
# Deployer wallet private key (sirf testnet wallet use karo! .env kabhi commit/share mat karna)
PRIVATE_KEY=0x...
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc
RH_TESTNET_CHAIN_ID=46630

# Token
TOKEN_NAME=Robin PoW
TOKEN_SYMBOL=XYZ

# Difficulty = required leading zero bits of the hash (har +1 bit = 2x mushkil)
#   20 bits ≈ 1M hashes     26 bits ≈ 67M hashes     28 bits ≈ 268M hashes
#   Browser CPU ≈ 100-300k hashes/sec per core (10 cores ≈ 1-3M/s → 26 bits ≈ 30-60s)
# Difficulty har block ke baad khud adjust hoti hai taaki ~60 sec mein ek block aaye
# (block jaldi aaya → 25% tak mushkil; der se aaya → aasaan).
MIN_DIFFICULTY_BITS=20
INITIAL_DIFFICULTY_BITS=26

# Marketplace fee (basis points): 100 = 1%, max 500 = 5%. Fee ETH goes to FEE_RECIPIENT (default: deployer)
MARKET_FEE_BPS=100
FEE_RECIPIENT=

# ---- Later: MAINNET ----
# RH_MAINNET_RPC=
# RH_MAINNET_CHAIN_ID=
