# ---- Robinhood Chain TESTNET deploy config ----
# Deployer wallet private key (use a testnet-only wallet! Never commit/share .env)
PRIVATE_KEY=0x...
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc
RH_TESTNET_CHAIN_ID=46630

# Token
TOKEN_NAME=Robin PoW
TOKEN_SYMBOL=XYZ

# Difficulty = required leading zero bits of the hash (every +1 bit = 2x harder)
#   20 bits ≈ 1M hashes     26 bits ≈ 67M hashes     28 bits ≈ 268M hashes
#   Browser CPU ≈ 100-300k hashes/sec per core (10 cores ≈ 1-3M/s → 27 bits ≈ 45-130s)
# Difficulty re-adjusts after every block to target ~2 min per block
# (fast block → up to 25% harder; slow block → easier).
MIN_DIFFICULTY_BITS=21
INITIAL_DIFFICULTY_BITS=27

# Marketplace fee (basis points): 100 = 1%, max 500 = 5%. Fee ETH goes to FEE_RECIPIENT (default: deployer)
MARKET_FEE_BPS=100
FEE_RECIPIENT=

# ---- Later: MAINNET ----
# RH_MAINNET_RPC=
# RH_MAINNET_CHAIN_ID=
