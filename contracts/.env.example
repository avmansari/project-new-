# ---- Robinhood Chain TESTNET deploy config ----
# Deployer wallet private key (sirf testnet wallet use karo! .env kabhi commit/share mat karna)
PRIVATE_KEY=0x...
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc
RH_TESTNET_CHAIN_ID=46630

# Token
TOKEN_NAME=Robin PoW
TOKEN_SYMBOL=XYZ

# Difficulty = required leading zero bits of the hash (every +1 bit = 2x harder)
#   16 bits ≈ 65k hashes   (phone: ~1s)
#   22 bits ≈ 4M hashes    (phone: ~20-40s, PC GPU: <1s)
# Retarget adjusts automatically every 32 blocks toward 60s/block.
MIN_DIFFICULTY_BITS=16
INITIAL_DIFFICULTY_BITS=22

# ---- Later: MAINNET ----
# RH_MAINNET_RPC=
# RH_MAINNET_CHAIN_ID=
