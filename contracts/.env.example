# ---- Robinhood Chain TESTNET deploy config ----
# Deployer wallet private key (use a testnet-only wallet! Never commit/share .env)
PRIVATE_KEY=0x...
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc
RH_TESTNET_CHAIN_ID=46630

# Token
TOKEN_NAME=Robin PoW
TOKEN_SYMBOL=XYZ

# Difficulty = required leading zero bits of the hash (every +1 bit = 2x harder)
#   20 bits ≈ 1M hashes     26 bits ≈ 67M hashes     28 bits ≈ 268M hashes
#   Browser CPU ≈ 100-300k hashes/sec per core (10 cores ≈ 1-3M/s → 27 bits ≈ 45-130s)
# Difficulty re-adjusts after every block to target ~2 min per block
# (fast block → up to 25% harder; slow block → easier).
MIN_DIFFICULTY_BITS=21
INITIAL_DIFFICULTY_BITS=27

# ---- Fees (all fee ETH goes to FEE_RECIPIENT; empty = the deployer wallet) ----
FEE_RECIPIENT=
# Claim fee per mined lot in USD, converted to ETH at deploy (keep it fresh with `npm run set-fee`)
MINT_FEE_USD=0.1
# Optional: fixed ETH price instead of fetching it (e.g. ETH_USD_PRICE=3000)
ETH_USD_PRICE=
# Optional: Chainlink-style ETH/USD feed on the chain -> fee always exactly MINT_FEE_USD
PRICE_FEED=
# Marketplace fee on trade volume (basis points): 200 = 2%, max 500 = 5%
MARKET_FEE_BPS=200
# DEX pool (instant swap) is OFF for now. To use it later: DEPLOY_POOL=true here + VITE_ENABLE_DEX=true for the web
DEPLOY_POOL=false
# DEX pool protocol fee on swaps (basis points): 200 = 2%, max 500. LPs additionally earn 0.3%
DEX_PROTOCOL_FEE_BPS=200

# ---- Later: MAINNET ----
# RH_MAINNET_RPC=
# RH_MAINNET_CHAIN_ID=
