# RPC of the chain to index (use a private RPC in production: Alchemy / QuickNode / Chainstack)
PONDER_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
# Production database (Postgres). Leave empty to use the embedded PGlite database.
DATABASE_URL=
# Allowed browser origins for the API (comma separated), e.g. https://your-site.vercel.app
CORS_ORIGIN=*
