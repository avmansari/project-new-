# Optional web config (copy to web/.env, or set in Vercel → Settings → Environment Variables)

# WalletConnect / Reown project id (free): https://cloud.reown.com → Create project → copy "Project ID".
# Enables the "WalletConnect" option (any phone wallet app via QR code).
VITE_WC_PROJECT_ID=

# Private RPC for production (Alchemy / QuickNode / Chainstack). Leave empty for the public RPC.
VITE_RPC_URL=

# Hosted indexer (the /indexer Ponder app), e.g. https://pow-indexer.up.railway.app
# Empty = the site indexes events itself from the RPC (fine for launch; slow with a big history).
VITE_INDEXER_URL=

# DEX pool (instant swap + liquidity). OFF for now; set to true only if the pool was deployed (DEPLOY_POOL=true)
VITE_ENABLE_DEX=false

# Analytics (optional): your site's domain as added in Plausible (https://plausible.io), e.g. yourapp.com
VITE_PLAUSIBLE_DOMAIN=
# Self-hosted Plausible? point to its script, e.g. https://stats.yourapp.com/js/script.js
VITE_PLAUSIBLE_SRC=
